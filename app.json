{
  "expo": {
    "name": "Etavia",
    "slug": "etavia",
    "scheme": "etavia",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.etavia.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "경유지에 도착하거나 출발한 것을 자동으로 알아차려 도착 시각을 다시 계산하는 데 사용해요.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "지도 앱을 보거나 화면이 꺼져 있어도 경유지 도착·출발을 알아차리려면 '항상 허용'이 필요해요. 운전 중에는 앱이 뒤에 있으니까요.",
        "UIBackgroundModes": [
          "location"
        ],
        "LSApplicationQueriesSchemes": [
          "nmap",
          "kakaomap",
          "comgooglemaps"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "말로 경유 조건을 넣을 때 마이크로 목소리를 들어요.",
          "speechRecognitionPermission": "들은 목소리를 글자로 바꿔 입력창에 채워요."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b138be35-f2e8-4186-ae54-cfb5f907f8eb"
      }
    }
  }
}
